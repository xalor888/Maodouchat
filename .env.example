APP_ENV=development
HOST=0.0.0.0
PORT=8080
BASE_URL=http://localhost:8080
JWT_SECRET=replace-with-a-long-random-development-secret

# Development default keeps data only while the server process is running.
# Use a file path or external database for real deployment.
DATABASE_URL=jdbc:h2:mem:maodouchat;DB_CLOSE_DELAY=-1
DATABASE_DRIVER=org.h2.Driver
STORAGE_DIR=./uploads
SEED_DEMO_USERS=true
# Comma-separated platform moderators. Development defaults to alex@example.com if omitted.
MODERATOR_EMAILS=alex@example.com
# Comma-separated user IDs with full web-admin access. Demo admin is u1.
# Production: register the account first, obtain its user ID, then set this and restart the server.
MASTER_ADMINS=u1

# Empty SMTP_HOST enables development mode: verification codes are printed to console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=毛豆聊天

# Optional AI Gateway. When OPENAI_API_KEY is empty, /api/ai/* returns 503
# and the rest of the chat server keeps running normally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional FCM HTTP v1. Both values are required to enable offline push.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

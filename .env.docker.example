# Copy this file to .env before running docker compose, OR just run:
#   bash scripts/deploy.sh --host your.domain.com --email you@example.com
# The script generates all secrets for you, starts the stack and waits for health.
#
# Production mode refuses weak or incomplete settings. For self-hosted private
# deployments without SMTP/TURN servers set RELAXED_VERIFICATION=true (see below).

APP_ENV=production
PUBLIC_HOST=api.example.com
# PUBLIC_HOST must resolve to this host; Caddy uses ACME_EMAIL for certificate notices.
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
BASE_URL=https://api.example.com

# ─── Required secrets ───────────────────────
# Generate at least 32 random characters, for example:
# openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
# Push payload HMAC signature key (≥32 chars). Required in production unless
# RELAXED_VERIFICATION=true. deploy.sh generates this automatically.
PUSH_HMAC_SECRET=replace-with-at-least-32-random-characters
POSTGRES_DB=maodouchat
POSTGRES_USER=maodouchat
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

SEED_DEMO_USERS=false
# Comma-separated platform moderators who can review reports.
MODERATOR_EMAILS=admin@example.com
# Full web-admin user IDs, not emails. Create the accounts first, then configure and restart.
# Alternative: set BOOTSTRAP_FIRST_USER_AS_ADMIN=true so the first registered user
# becomes the owner admin automatically (one-time bootstrap, then set it back to false).
MASTER_ADMINS=replace-with-admin-user-id

# Comma-separated user IDs allowed into the developer bot platform (empty = any password-authed account).
DEVELOPER_USER_IDS=

# 0.74: Comma-separated email domains banned from registration (throwaway/abuse domains).
# Example: EMAIL_DOMAIN_BLOCKLIST=mailinator.com,temp-mail.org
EMAIL_DOMAIN_BLOCKLIST=

# Optional HikariCP pool size (defaults to CPU*2+1, capped at 64; range 2..128).
DATABASE_POOL_SIZE=

# ─── Self-hosted relaxed mode ───────────────
# Set to true to allow starting WITHOUT SMTP and/or TURN (e.g. private self-hosted
# deployments). Effects:
#   - SMTP missing  -> verification codes are printed to server logs
#     (set DEV_LOG_CODES=true to see them)
#   - TURN missing  -> calls fall back to STUN only (NAT traversal less reliable)
#   - PUSH_HMAC_SECRET missing -> push signature verification disabled (fail-open)
# JWT_SECRET/HTTPS BASE_URL/persistent DB checks remain mandatory.
RELAXED_VERIFICATION=false
# Print email verification codes to server logs (needed in relaxed mode without SMTP).
DEV_LOG_CODES=false
# One-time bootstrap: grant admin rights to the FIRST user ever registered.
# Recommended flow: set to true -> deploy -> register your account -> set back to false -> redeploy.
BOOTSTRAP_FIRST_USER_AS_ADMIN=false

# ─── SMTP (optional in relaxed mode, required otherwise) ──────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM_NAME=毛豆聊天

# Optional AI Gateway. Leave OPENAI_API_KEY empty to disable AI endpoints.
OPENAI_API_KEY=
# Chat model — use a real model name supported by your OPENAI_BASE_URL.
# Common OpenAI names: gpt-4o-mini, gpt-4o, gpt-4-turbo. Adjust for custom gateways.
OPENAI_MODEL=gpt-4o-mini
# Advanced: per-task model overrides (light for translate/rewrite, strong for summarize,
# fallback retried once on upstream errors). Leave empty to fall back to OPENAI_MODEL defaults.
OPENAI_MODEL_LIGHT=
OPENAI_MODEL_STRONG=
OPENAI_MODEL_FALLBACK=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional FCM HTTP v1. Bind-mount the JSON file into the server container and
# set this to the path inside the container.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# ─── WebRTC (optional in relaxed mode, required otherwise) ────────────
# TURN_SHARED_SECRET must match coturn (docker-compose uses this value).
# TURN_REALM/TURN_URLS should use a DNS name that resolves to this deployment.
# Leave all three empty in relaxed mode for STUN-only calls.
TURN_REALM=turn.example.com
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SHARED_SECRET=replace-with-at-least-32-random-characters
TURN_CREDENTIAL_TTL_SECONDS=3600

# ─── Rate Limiting ──────────────────────────
# Global API requests per minute per IP (default 120)
GLOBAL_RATE_LIMIT_PER_MINUTE=120
# Login/register attempts per minute per IP (default 10)
AUTH_RATE_LIMIT_PER_MINUTE=10
# AI endpoint requests per minute per user (default 20)
AI_RATE_LIMIT_PER_MINUTE=20

# ─── Upload Limits ──────────────────────────
# Max Base64 image upload size in characters (default 2800000, ~2MB decoded)
MAX_BASE64_IMAGE_CHARS=2800000
# Max decoded image bytes (default 2097152, 2MB)
MAX_IMAGE_BYTES=2097152
# Max image dimension in pixels (default 4096)
MAX_IMAGE_DIMENSION=4096
# Max encrypted attachment size per object in bytes (default 104857600, 100MB)
MAX_ATTACHMENT_BYTES=104857600
# Per-user storage quota in bytes (default 1073741824, 1GB)
USER_STORAGE_QUOTA_BYTES=1073741824

# ─── Security ───────────────────────────────
# Set to false to disable new user registration (invite-only mode)
ALLOW_REGISTRATION=true
# Random hidden admin URL prefix. Full admin URL: https://<PUBLIC_HOST>/<ADMIN_PATH>/admin
# deploy.sh generates this automatically; keep it secret.
ADMIN_PATH=replace-with-random-admin-path
# Comma-separated allowed CORS origins (e.g. https://app.example.com)
# Leave empty for same-origin only
CORS_ORIGINS=
# Trust proxy headers (X-Forwarded-For) for client IP detection
# Set to true only when behind a known reverse proxy (Caddy/Nginx)
TRUST_PROXY_HEADERS=true

# ─── Ops ────────────────────────────────────
# Keep this many most-recent backup-production.sh archives, pruning older ones.
# Set to 0 to disable pruning (default 14).
# BACKUP_KEEP=14
# Deploy health-wait timeout in seconds (default 300). Raise for slow-start/large-migration hosts.
# HEALTH_TIMEOUT_SECONDS=300
# Minimum free disk space (MB) required before backup-production.sh starts (default 1024).
# BACKUP_MIN_FREE_MB=1024
# status.sh --watch refresh interval in seconds (default 5).
# STATUS_WATCH_INTERVAL=5

# ─── Third-party server branding (optional) ───
# Shown in the app when users connect to this server (third-party server mode).
# Announcement can also be placed at STORAGE_DIR/server-announcement.txt (no restart needed).
SERVER_NAME=
SERVER_DESCRIPTION=
SERVER_ANNOUNCEMENT=
SERVER_CONTACT_URL=

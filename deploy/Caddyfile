{
    email {$ACME_EMAIL}
    admin off
}

# API 和主站点
{$PUBLIC_HOST} {
    # 管理后台隐藏路径：/admin 直接 404，只有随机前缀下的 /admin 可访问
    route {
        @admin_page path /admin /admin/
        respond @admin_page 404

        @hidden_exact path /{$ADMIN_PATH}/admin
        handle @hidden_exact {
            rewrite * /admin
            reverse_proxy server:8080
        }

        @hidden_prefix path_regexp hidden_prefix ^/{$ADMIN_PATH}/admin/(.+)$
        handle @hidden_prefix {
            rewrite * /admin/{re.hidden_prefix.1}
            reverse_proxy server:8080
        }
    }

    encode zstd gzip

    # WebRTC native .so is SHA-256 checked on the client. Compressing it
    # rewrites the body while the ETag still names the uncompressed hash.
    @webrtc_lib path /api/webrtc/lib/*
    header @webrtc_lib Content-Encoding identity
    encode @webrtc_lib none

    # 8.48 修复：上限须与 server 的 MAX_ATTACHMENT_BYTES 匹配（附件为 base64 载荷，约 4/3 膨胀）。
    # 默认 140MB 覆盖默认 100MB 附件上限；两个变量请在 .env 中一起调整
    request_body {
        max_size {$MAX_BODY_BYTES:146800640}
    }

    reverse_proxy server:8080 {
        # Ktor only trusts these headers when TRUST_PROXY_HEADERS=true. Caddy overwrites
        # X-Real-IP with the actual peer address so clients cannot select their rate-limit key.
        header_up X-Real-IP {remote_host}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    @admin path /admin /admin/*
    header @admin Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # 1.275：错误统一返回 JSON（避免泄漏 Caddy 默认 HTML）
    handle_errors {
        @4xx expression {http.error.status_code} >= 400 && {http.error.status_code} < 500
        @5xx expression {http.error.status_code} >= 500
        respond @4xx `{"error":{ "code": {http.error.status_code} }}` 400
        respond @5xx `{"error":{ "code": {http.error.status_code} }}` 500
    }

    log {
        output stdout
        format console
    }
}

/**
 * Murexide-style incoming bubble colors for light and dark themes.
 * Directly mirrored from reference/Murexide MessageBubble palette.
 */
private val MurexideWhiteIncomingLight = Color(0xFFEEEEF0)
private val MurexideWhiteIncomingDark = Color(0xFF1E1E20)

/**
 * Murexide 纯正风格聊天气泡：
 * 1. 动态圆角：标准 18dp，连续消息邻边压缩至 4.5dp，呈现自然的连续聊天气泡流；
 * 2. 质感配色：浅色对齐 Murexide #EEEEF0，深色 #1E1E20，己方主色容器；
 * 3. 引用样式：左侧 3dp 竖向高光色块，清晰的发送人与引用正文微缩；
 * 4. 底部对齐的 36dp 精致圆形头像；
 * 5. 紧凑内嵌的时间与送达/已读双勾回执。
 */
@Composable
fun MurexideMessageBubble(
    message: Message,
    isOwnMessage: Boolean,
    modifier: Modifier = Modifier,
    showAvatar: Boolean = true,
    showSenderName: Boolean = false,
    isGroupEdge: Boolean = true,
    senderName: String? = null,
    memberRole: String? = null,
    isGroupChat: Boolean = false,
    replyToPreview: ReplyPreview? = null,
    onReplyPreviewClick: ((Message) -> Unit)? = null,
    onBoundsMeasured: ((IntOffset, IntSize) -> Unit)? = null,
    onImageClick: ((Message) -> Unit)? = null,
    onVideoClick: ((Message) -> Unit)? = null,
    onFileClick: ((Message) -> Unit)? = null,
    onReactionClick: ((String) -> Unit)? = null,
    onStatusClick: ((Message) -> Unit)? = null,
    onSenderClick: ((String) -> Unit)? = null,
    isHighlighted: Boolean = false,
    content: @Composable () -> Unit,
) {
    val isDark = isSystemInDarkTheme()
    val liquidGlassEnabled = LocalLiquidGlassEnabled.current
    val backdrop = LocalLiquidGlassBackdrop.current

    val incomingBubbleColor = if (isDark) {
        MurexideWhiteIncomingDark
    } else {
        MurexideWhiteIncomingLight
    }

    val outgoingBubbleColor = MaterialTheme.colorScheme.primaryContainer

    val bubbleColor = if (isOwnMessage) outgoingBubbleColor else incomingBubbleColor

    val bubbleCornerRadius = 18f
    val sharpRadius = 4.5f

    // Consecutive bubble corners:
    // If not isGroupEdge (i.e. consecutive message in group), tighten the tail corner.
    val topStartRadius = if (!isOwnMessage && !isGroupEdge) sharpRadius.dp else bubbleCornerRadius.dp
    val topEndRadius = if (isOwnMessage && !isGroupEdge) sharpRadius.dp else bubbleCornerRadius.dp
    val bottomStartRadius = if (!isOwnMessage && isGroupEdge) sharpRadius.dp else bubbleCornerRadius.dp
    val bottomEndRadius = if (isOwnMessage && isGroupEdge) sharpRadius.dp else bubbleCornerRadius.dp

    val bubbleShape = RoundedCornerShape(
        topStart = topStartRadius,
        topEnd = topEndRadius,
        bottomStart = bottomStartRadius,
        bottomEnd = bottomEndRadius,
    )

    val highlightColor by animateColorAsState(
        targetValue = if (isHighlighted) {
            MaterialTheme.colorScheme.primary.copy(alpha = 0.22f)
        } else {
            Color.Transparent
        },
        animationSpec = tween(durationMillis = 250),
        label = "murexide_bubble_highlight"
    )

    val configuration = LocalConfiguration.current
    val maxBubbleWidth = (configuration.screenWidthDp * 0.78f).dp

    Row(
        modifier = modifier
            .fillMaxWidth()
            .background(highlightColor, shape = RoundedCornerShape(12.dp))
            .padding(
                start = 8.dp,
                end = 8.dp,
                top = if (isGroupEdge) 4.dp else 1.dp,
                bottom = if (isGroupEdge) 4.dp else 1.dp
            ),
        horizontalArrangement = if (isOwnMessage) Arrangement.End else Arrangement.Start,
        verticalAlignment = Alignment.Bottom
    ) {
        // Peer avatar on the left
        if (!isOwnMessage) {
            if (showAvatar && isGroupEdge) {
                Avatar(
                    name = senderName ?: "?",
                    size = AvatarSize.SM,
                    modifier = Modifier.clickable(enabled = onSenderClick != null) {
                        onSenderClick?.invoke(message.senderId)
                    }
                )
                Spacer(modifier = Modifier.width(8.dp))
            } else {
                Spacer(modifier = Modifier.width(44.dp))
            }
        }

        Column(
            horizontalAlignment = if (isOwnMessage) Alignment.End else Alignment.Start,
            modifier = Modifier.widthIn(max = maxBubbleWidth)
        ) {
            // Group sender header (name + role badge)
            if (!isOwnMessage && showSenderName && senderName != null) {
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    modifier = Modifier
                        .padding(start = 6.dp, bottom = 3.dp)
                        .clickable(enabled = onSenderClick != null) {
                            onSenderClick?.invoke(message.senderId)
                        }
                ) {
                    Text(
                        text = senderName,
                        style = MaterialTheme.typography.labelMedium,
                        fontWeight = FontWeight.SemiBold,
                        color = MaterialTheme.colorScheme.primary,
                        maxLines = 1,
                        overflow = TextOverflow.Ellipsis
                    )
                    if (memberRole != null) {
                        Spacer(modifier = Modifier.width(4.dp))
                        RoleBadge(
                            label = if (memberRole == "OWNER") {
                                stringResource(R.string.chat_role_owner)
                            } else {
                                stringResource(R.string.chat_role_admin)
                            },
                            owner = memberRole == "OWNER"
                        )
                    }
                }
            }

            // Quote reply preview
            if (replyToPreview != null) {
                MurexideQuoteReplyPreview(
                    replyTo = replyToPreview,
                    isOwnMessage = isOwnMessage,
                    onClick = { onReplyPreviewClick?.invoke(message) }
                )
                Spacer(modifier = Modifier.height(3.dp))
            }

            // Main Bubble Card
            Surface(
                shape = bubbleShape,
                color = bubbleColor,
                shadowElevation = 0.5.dp,
                modifier = Modifier
                    .captureBubbleBounds(onBoundsMeasured)
                    .then(
                        if (liquidGlassEnabled && backdrop != null) {
                            Modifier.liquidGlass(
                                enabled = true,
                                backdrop = backdrop,
                                shape = bubbleShape,
                                surfaceColor = bubbleColor.copy(alpha = 0.88f),
                                blurRadius = 4.dp
                            )
                        } else {
                            Modifier
                        }
                    )
            ) {
                Column(
                    modifier = Modifier.padding(horizontal = 10.dp, vertical = 7.dp)
                ) {
                    content()

                    // Inline/bottom metadata: timestamp and status receipts
                    Row(
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.End,
                        modifier = Modifier
                            .align(Alignment.End)
                            .padding(top = 2.dp)
                    ) {
                        Text(
                            text = formatBubbleTime(message.timestamp),
                            style = MaterialTheme.typography.labelSmall.copy(fontSize = 10.sp),
                            color = if (isOwnMessage) {
                                MaterialTheme.colorScheme.onPrimaryContainer.copy(alpha = 0.65f)
                            } else {
                                MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.65f)
                            }
                        )

                        if (isOwnMessage) {
                            Spacer(modifier = Modifier.width(3.dp))
                            MurexideMessageStatus(
                                status = message.status,
                                onClick = { onStatusClick?.invoke(message) }
                            )
                        }
                    }
                }
            }

            // Reactions row
            if (message.reactions.isNotEmpty()) {
                ReactionSummaryRow(
                    message = message,
                    currentUserId = null,
                    isOwnMessage = isOwnMessage,
                    onReactionClick = onReactionClick
                )
            }
        }
    }
}

@Composable
private fun MurexideQuoteReplyPreview(
    replyTo: ReplyPreview,
    isOwnMessage: Boolean,
    onClick: () -> Unit,
) {
    Row(
        verticalAlignment = Alignment.CenterVertically,
        modifier = Modifier
            .clip(RoundedCornerShape(8.dp))
            .background(
                if (isOwnMessage) {
                    MaterialTheme.colorScheme.primary.copy(alpha = 0.15f)
                } else {
                    MaterialTheme.colorScheme.surfaceContainerHigh.copy(alpha = 0.75f)
                }
            )
            .clickable(onClick = onClick)
            .padding(horizontal = 8.dp, vertical = 4.dp)
    ) {
        // Accent left bar
        Box(
            modifier = Modifier
                .width(3.dp)
                .height(28.dp)
                .clip(RoundedCornerShape(1.5.dp))
                .background(MaterialTheme.colorScheme.primary)
        )
        Spacer(modifier = Modifier.width(6.dp))
        Column {
            Text(
                text = replyTo.senderName,
                style = MaterialTheme.typography.labelSmall,
                fontWeight = FontWeight.Bold,
                color = MaterialTheme.colorScheme.primary,
                maxLines = 1,
                overflow = TextOverflow.Ellipsis
            )
            Text(
                text = replyTo.preview,
                style = MaterialTheme.typography.bodySmall,
                color = MaterialTheme.colorScheme.onSurfaceVariant,
                maxLines = 1,
                overflow = TextOverflow.Ellipsis
            )
        }
    }
}

@Composable
private fun MurexideMessageStatus(
    status: MessageStatus,
    onClick: (() -> Unit)? = null,
) {
    val tint = MaterialTheme.colorScheme.onPrimaryContainer.copy(alpha = 0.72f)
    val modifier = Modifier
        .size(13.dp)
        .then(if (onClick != null) Modifier.clickable(onClick = onClick) else Modifier)

    when (status) {
        MessageStatus.SENDING -> {
            CircularProgressIndicator(
                strokeWidth = 1.2.dp,
                color = tint,
                modifier = modifier
            )
        }
        MessageStatus.SENT -> {
            Icon(
                imageVector = Icons.Default.Check,
                contentDescription = "Sent",
                tint = tint,
                modifier = modifier
            )
        }
        MessageStatus.DELIVERED -> {
            Icon(
                imageVector = Icons.Default.DoneAll,
                contentDescription = "Delivered",
                tint = tint,
                modifier = modifier
            )
        }
        MessageStatus.READ -> {
            Icon(
                imageVector = Icons.Default.DoneAll,
                contentDescription = "Read",
                tint = MaterialTheme.colorScheme.primary,
                modifier = modifier
            )
        }
        MessageStatus.FAILED -> {
            Icon(
                imageVector = Icons.Outlined.ErrorOutline,
                contentDescription = "Failed",
                tint = MaterialTheme.colorScheme.error,
                modifier = modifier
            )
        }
    }
}

private fun formatBubbleTime(timestampMs: Long): String = try {
    SimpleDateFormat("HH:mm", Locale.getDefault()).format(Date(timestampMs))
} catch (_: Exception) {
    ""
}

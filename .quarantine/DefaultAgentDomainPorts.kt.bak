package com.maodouchat.ai.agent.ports

import com.maodouchat.MaodouchatApp
import com.maodouchat.ai.agent.AgentToolPolicy
import com.maodouchat.ai.prompt.AiPromptSafetyPolicy
import com.maodouchat.data.TokenManager
import com.maodouchat.network.ApiService
import com.maodouchat.data.local.AiTaskEntity
import com.maodouchat.data.local.LikeQueryPolicy
import com.maodouchat.data.local.toDomain
import com.maodouchat.data.model.Message
import com.maodouchat.data.model.MessageMeta
import com.maodouchat.data.model.MessageReaction
import com.maodouchat.data.model.MessageStatus
import com.maodouchat.data.model.MessageType
import com.maodouchat.data.privacy.AgentSecretGatePolicy
import com.maodouchat.data.privacy.ChatLockSession
import com.maodouchat.data.privacy.ConversationPrivacyPolicy
import com.maodouchat.data.privacy.PrivacyAction
import com.maodouchat.data.repository.ChatRepository
import com.maodouchat.data.repository.LocalMessageStore
import com.maodouchat.messaging.v2.MessagingV2Event
